{% include 'racf_alert_base.html.j2' %}

<h3>zSecure Alert: Logon by unknown user</h3>

<div class="alert-box">
  <p>
    <b>Alert Code:</b> {{ alert_code }}<br/>
    <b>User ID:</b> {{ target_user }}<br/>
    <b>Group:</b> {{ group_name }}<br/>
    <b>Job Name:</b> {{ job_name }}<br/>
    <b>Hostname:</b> {{ hostname }}
  </p>
</div>

<h4>Alert Details</h4>
<div class="info-box">
  <p><b>zSecure Alert:</b> {{ alert_message }}</p>
  <p>
    <b>Automated Action Taken:</b><br/>
    Event-Driven Ansible {{ action_message }} the command <code>SETROPTS JES(BATCHALLRACF) </code>
    on z/OS host <b>{{ hostname }}</b> to test for the presence of a user ID and password on the job statement.
  </p>
</div>

<hr/>
<p style="font-size: 0.9em; color: #667;">
  <i>*** DO NOT REPLY TO THIS MESSAGE. IT IS SENT BY AN EVENT-DRIVEN ANSIBLE SERVICE MACHINE ***</i>
</p>

</body>
</html>