# For additonal doc, see https://ansible.readthedocs.io/projects/lint/configuring/
exclude_paths:
  - .ansible/
  - .ansible-lint
  - .cache/
  - .DS_Store
  - .git/
  - .github/
  - .gitignore
  - .pytest_cache/
  - .python-version
  - .vscode/
  - __pycache__/
  - ansible.cfg
  - ansible_collections/
  - branch_protection_rules.json
  - changelogs/
  - collections/
  - devfile.yaml
  - docs/
  - playbooks/security/
  - scripts/
  - tests/
  - "*.log"
  - "*.tar.gz"
  - "venv*"
quiet: false
use_default_rules: true
verbosity: 1
# Offline mode disables installation of requirements.yml and schema refreshing often
# found in project_root/collections/requirements.yml.
offline: true
